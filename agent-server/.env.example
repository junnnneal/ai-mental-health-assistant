# agent-server 环境变量样例：复制为 .env（本地）或配到 Render（生产）
# 注意：.env 已 gitignore，真实密钥不进仓库

# 必填：智谱 GLM API key（与前端项目同一把）
GLM_API_KEY=

# 课程后端地址
BACKEND_BASE=http://159.75.169.224:1235/api

# 允许的跨站来源（逗号分隔）。本地直连调试用；生产流量走 Netlify 同源转发
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# /kb/rebuild 管理令牌：留空 = 端点禁用
ADMIN_TOKEN=

# ---- 以下可选，一般不用改 ----
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CHAT_MODEL=glm-4-flash-250414
# EMBED_MODEL=embedding-2
# KB_BACKEND=chroma        # chroma | json（内存紧张时回退纯Python余弦）
# CHROMA_DIR=./chroma_data
# RAG_TOP_K=3
